# ==============================================================================
# End-to-End Data Platform Environment Configuration Template
# COPY THIS FILE TO .env BEFORE RUNNING CONTAINERS/PIPELINES
# NEVER COMMIT YOUR LOCAL .env FILE TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Mock ERP PostgreSQL Database
# ------------------------------------------------------------------------------
MOCK_ERP_POSTGRES_USER=mock_erp
MOCK_ERP_POSTGRES_PASSWORD=change-me-mock-erp-password
MOCK_ERP_POSTGRES_DB=mock_erp
MOCK_ERP_PG_EXTERNAL_PORT=55432

# ------------------------------------------------------------------------------
# Data Warehouse PostgreSQL Database
# ------------------------------------------------------------------------------
WAREHOUSE_POSTGRES_USER=analytics
WAREHOUSE_POSTGRES_PASSWORD=change-me-warehouse-password
WAREHOUSE_POSTGRES_DB=analytics_warehouse
DATA_WAREHOUSE_PG_EXTERNAL_PORT=55433

# ------------------------------------------------------------------------------
# MinIO Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_EXTERNAL_PORT=9002
MINIO_CONSOLE_EXTERNAL_PORT=9001

# ------------------------------------------------------------------------------
# Airflow Orchestration
# ------------------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db-password
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_EXTERNAL_PORT=5435
# Optional for local development (Compose uses the shared key from airflow.cfg).
# Required outside local development. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_EXTERNAL_PORT=8081
AIRFLOW_FLOWER_EXTERNAL_PORT=5555
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_UID=50000

# ------------------------------------------------------------------------------
# Odoo ERP & PostgreSQL Database
# ------------------------------------------------------------------------------
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-odoo-db-password
ODOO_DB_NAME=postgres

# ------------------------------------------------------------------------------
# Pipeline & Dashboard Configurations
# ------------------------------------------------------------------------------
PIPELINE_INTERVAL_SECONDS=30
PIPELINE_STARTUP_RETRY_SECONDS=5
DASHBOARD_EXTERNAL_PORT=8501
MOCK_DATA_PRODUCER_INTERVAL_SECONDS=10
MOCK_DATA_PRODUCER_DAYS_PER_BATCH=1
